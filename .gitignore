# Ignore everything by default
*
!*/

# Re-ignore directories we never want tracked
.idea/
__pycache__/
.venv/
venv/
env/
.claude/

# Track only these file types
!*.py
!*.md
!*.json
!*.txt
!*.toml
!*.skill
!*.cs
!*.bat

# The add-on's own icons
!addons/MultiCamProject/icons/*.png

# Always ignore build outputs and Blender temp files
*.zip
*.blend
*.blend1
*.bak
build_info.json
